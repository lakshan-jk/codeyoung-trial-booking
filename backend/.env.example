# Backend configuration. Copy to `.env` and adjust as needed.
PORT=4000

# Single-node replica set started by docker-compose. directConnection=true lets the
# driver talk to the single node without doing replica-set host discovery.
MONGODB_URI=mongodb://localhost:27017/codeyoung?replicaSet=rs0&directConnection=true

# Comma-separated list of origins allowed to call the API (the Vite dev server).
CORS_ORIGIN=http://localhost:5173

# Base URL for the (dummy) class link. Points at the app's in-app demo room so the
# link actually opens something. In production this would be the real video platform.
CLASS_LINK_BASE_URL=http://localhost:5173/room
